/* 반투명 어두운 오버레이 */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
    display: flex;
}

/* 카드 (초기: 뒷면 = 어두운 배경) */
.card {
    width: 240px;
    height: 340px;
    border-radius: 14px;
    border-width: 3px;
    border-color: rgb(180, 140, 55);
    background-color: rgb(18, 12, 38);
    /* 이미지는 C#에서 플립 중간에 backgroundImage로 주입 */
    background-size: cover;
    background-position: center;
}
