/* 반투명 어두운 오버레이 */
.overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
    display: flex;
}

/* 카드 (초기: 뒷면 = 어두운 배경) */
/* % 단위: overlay가 화면 전체이므로 화면 크기에 비례해서 스케일됨 */
.card {
    width: 195px;
    height: 278px;
    border-radius: 12px;
    background-color: rgb(18, 12, 38);
    background-size: 100% 100%;
    -unity-background-scale-mode: stretch-to-fill;
}
