.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    align-items: flex-start;
    justify-content: flex-end;
}

.loading-label {
    font-size: 28px;
    color: rgb(255, 255, 255);
    margin-left: 32px;
    margin-bottom: 32px;
    -unity-font-style: bold;
}
