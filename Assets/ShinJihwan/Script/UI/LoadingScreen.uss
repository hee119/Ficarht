/* 전체 화면 검은 배경 */
.root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    align-items: flex-start;
    justify-content: flex-end;
}

/* 왼쪽 하단 Loading 텍스트 */
.loading-label {
    font-size: 28px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin-left: 36px;
    margin-bottom: 36px;
}
