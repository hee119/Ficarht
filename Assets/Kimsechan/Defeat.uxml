<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement name="result-root" style="flex-grow: 1; align-items: center; justify-content: center; padding-left: 24px; padding-right: 24px; padding-top: 20px; padding-bottom: 20px; background-color: rgba(0, 0, 0, 0.52);">
        <ui:VisualElement name="result-panel" style="width: 460px; max-width: 100%; min-height: 230px; padding-left: 28px; padding-right: 28px; padding-top: 28px; padding-bottom: 28px; align-items: center; justify-content: center; background-color: rgba(36, 34, 38, 0.94); border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-left-color: rgb(145, 48, 48); border-right-color: rgb(145, 48, 48); border-top-color: rgb(145, 48, 48); border-bottom-color: rgb(145, 48, 48); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
            <ui:Label name="result-title" text="패배하셨습니다..." style="font-size: 40px; -unity-font-style: bold; color: rgb(255, 226, 226); -unity-text-align: middle-center; white-space: normal;" />
            <ui:VisualElement name="result-buttons" style="margin-top: 26px; width: 230px; max-width: 100%;">
                <ui:Button name="main-menu-button" text="메인 메뉴로 가기" style="height: 42px; margin-bottom: 10px; font-size: 16px; -unity-font-style: bold; color: rgb(36, 30, 24); background-color: rgb(218, 204, 178); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(82, 68, 52); border-right-color: rgb(82, 68, 52); border-top-color: rgb(82, 68, 52); border-bottom-color: rgb(82, 68, 52);" />
                <ui:Button name="quit-button" text="게임 나가기" style="height: 42px; font-size: 16px; -unity-font-style: bold; color: rgb(255, 238, 229); background-color: rgb(128, 36, 32); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(64, 18, 16); border-right-color: rgb(64, 18, 16); border-top-color: rgb(64, 18, 16); border-bottom-color: rgb(64, 18, 16);" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="quit-confirm-overlay" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.66); display: none;">
            <ui:VisualElement name="quit-confirm-panel" style="width: 360px; max-width: 86%; padding-left: 24px; padding-right: 24px; padding-top: 24px; padding-bottom: 24px; align-items: center; background-color: rgba(245, 239, 225, 0.98); border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px; border-left-color: rgb(55, 42, 30); border-right-color: rgb(55, 42, 30); border-top-color: rgb(55, 42, 30); border-bottom-color: rgb(55, 42, 30); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px;">
                <ui:Label name="quit-confirm-title" text="진짜로 나가시겠습니까?" style="font-size: 24px; -unity-font-style: bold; color: rgb(38, 30, 23); -unity-text-align: middle-center; white-space: normal;" />
                <ui:VisualElement name="quit-confirm-buttons" style="margin-top: 24px; flex-direction: row; justify-content: center;">
                    <ui:Button name="quit-confirm-yes-button" text="예" style="width: 132px; height: 44px; margin-right: 12px; font-size: 18px; -unity-font-style: bold; color: rgb(255, 244, 238); background-color: rgb(128, 36, 32);" />
                    <ui:Button name="quit-confirm-no-button" text="아니오" style="width: 132px; height: 44px; font-size: 18px; -unity-font-style: bold; color: rgb(36, 30, 24); background-color: rgb(218, 204, 178);" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
