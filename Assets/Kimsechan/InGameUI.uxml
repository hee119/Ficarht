<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:VisualElement name="ingame-root" style="flex-grow: 1; position: relative;">
        <ui:VisualElement name="player-ui-anchor" style="position: absolute; left: 24px; top: 22px; flex-direction: row; align-items: flex-start;">
            <ui:VisualElement name="player-ui-panel" style="width: 310px; min-height: 96px; padding-left: 16px; padding-right: 16px; padding-top: 14px; padding-bottom: 14px; background-color: rgba(31, 36, 42, 0.82); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgba(255, 255, 255, 0.22); border-right-color: rgba(255, 255, 255, 0.22); border-top-color: rgba(255, 255, 255, 0.22); border-bottom-color: rgba(255, 255, 255, 0.22); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
                <ui:Label name="player-name" text="PLAYER" style="font-size: 18px; -unity-font-style: bold; color: rgb(255, 255, 255);" />
                <ui:VisualElement name="player-hp-bar" style="height: 18px; margin-top: 10px; background-color: rgba(0, 0, 0, 0.45); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; overflow: hidden;">
                    <ui:VisualElement name="player-hp-fill" style="width: 100%; flex-grow: 1; background-color: rgb(74, 205, 108);" />
                </ui:VisualElement>
                <ui:Label name="player-hp-text" text="100 / 100" style="margin-top: 5px; font-size: 13px; color: rgb(225, 232, 225);" />
            </ui:VisualElement>

            <ui:VisualElement name="my-trap-note" class="trap-note" style="width: 132px; height: 174px; margin-left: 14px; rotate: -4deg; translate: 0 0; background-color: rgb(255, 239, 139); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(168, 139, 55); border-right-color: rgb(168, 139, 55); border-top-color: rgb(168, 139, 55); border-bottom-color: rgb(168, 139, 55); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;">
                <ui:VisualElement name="my-trap-tape" style="position: absolute; left: 38px; top: -10px; width: 56px; height: 22px; background-color: rgba(255, 255, 255, 0.62);" />
                <ui:VisualElement name="my-trap-card" style="margin-left: 10px; margin-right: 10px; margin-top: 18px; margin-bottom: 8px; flex-grow: 1; background-color: rgba(255, 255, 255, 0.7); -unity-background-scale-mode: scale-to-fit;" />
                <ui:Label name="my-trap-label" text="TRAP" style="height: 24px; font-size: 12px; -unity-font-style: bold; color: rgb(75, 54, 14); -unity-text-align: middle-center;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="enemy-trap-note" class="trap-note" style="position: absolute; right: 30px; top: 24px; width: 132px; height: 174px; rotate: 4deg; translate: 0 0; background-color: rgb(154, 26, 34); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(82, 9, 15); border-right-color: rgb(82, 9, 15); border-top-color: rgb(82, 9, 15); border-bottom-color: rgb(82, 9, 15); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;">
            <ui:VisualElement name="enemy-trap-tape" style="position: absolute; left: 38px; top: -10px; width: 56px; height: 22px; background-color: rgba(255, 255, 255, 0.55);" />
            <ui:VisualElement name="enemy-trap-card" style="margin-left: 10px; margin-right: 10px; margin-top: 18px; margin-bottom: 8px; flex-grow: 1; background-color: rgb(197, 36, 48); -unity-background-scale-mode: scale-to-fit;" />
            <ui:Label name="enemy-trap-label" text="ENEMY" style="height: 24px; font-size: 12px; -unity-font-style: bold; color: rgb(255, 236, 236); -unity-text-align: middle-center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
