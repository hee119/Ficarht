<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="lava-root" style="
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        width: 100%; height: 100%;
        pointer-events: none;
    ">
        <!-- 화면 빨간 오버레이 -->
        <ui:VisualElement name="lava-overlay" style="
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            width: 100%; height: 100%;
            background-color: rgba(0,0,0,0);
        "/>

        <!-- 경고 패널 -->
        <ui:VisualElement name="lava-warning-panel" style="
            position: absolute;
            top: 5%;
            left: 0; right: 0;
            align-items: center;
            display: none;
        ">
            <ui:VisualElement name="lava-warning-box" style="
                background-color: rgba(180, 30, 0, 0.75);
                border-radius: 6px;
                padding: 5px 16px;
                flex-direction: row;
                align-items: center;
            ">
                <ui:Label name="lava-warning-icon" text="🔥" style="
                    font-size: 16px;
                    margin-right: 6px;
                    -unity-text-align: middle-center;
                "/>
                <ui:Label name="lava-warning-text" text="용암에서 벗어나세요!" style="
                    font-size: 14px;
                    color: rgb(255, 220, 180);
                    -unity-font-style: bold;
                    -unity-text-align: middle-center;
                "/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>